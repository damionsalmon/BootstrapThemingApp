@page "/SalFormbuilder"

@inject HttpClient Http

<PageTitle>Form Builder</PageTitle>

<h1 class="text-primary py-3">Form Builder</h1>

<FormBuilder Config="@Config"
             Model="@Model"
             SubmitLabel="Save changes"
             CancelLabel="Close"
             OnSubmit="HandleSubmit"
             OnCancel="HandleCancel" />

@code {
    private UserCredentialsModel Model = new();
    private FormConfig Config = new();

    protected override async Task OnInitializedAsync()
    {
        // Load config + model from JSON under wwwroot/form-configs
        var def = await Http.GetFromJsonAsync<DynamicFormDefinition<UserCredentialsModel>>(
            "form-configs/user-credentials.json");

        if (def is not null)
        {
            Config = def.Config ?? new FormConfig();
            Model = def.Model ?? new UserCredentialsModel();
        }
    }

    private Task HandleSubmit(object model)
    {
        Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(model));
        return Task.CompletedTask;
    }

    private Task HandleCancel()
    {
        Console.WriteLine("Cancelled");
        return Task.CompletedTask;
    }
}
